# 科大讯飞星火 API（可填写一套或两套）
SPARK_API_KEY=your_spark_api_key
SPARK_API_SECRET=your_spark_api_secret
SPARK_APP_ID=your_spark_app_id

# 若使用 OpenAI 兼容接口：
# 1) 可直接填写 HTTP APIpassword
# 2) 或填写 APIKey:APISecret
OPENAI_API_KEY=your_api_password_or_ak:sk
# 不要带 /chat/completions；Ultra 用 v1 + 模型名 4.0Ultra（与控制台 Websocket 地址不是同一套）
OPENAI_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=4.0Ultra

# LLM HTTP 超时（秒）：连接超时 / 单次读响应超时（资源生成可能较长，默认 read=240）
LLM_HTTP_CONNECT_TIMEOUT=20
LLM_HTTP_READ_TIMEOUT=240
LLM_HTTP_WRITE_TIMEOUT=60
# SDK 内建重试次数（默认 2，与 OpenAI SDK 一致；设为 0 则完全不重试）
LLM_HTTP_MAX_RETRIES=2

# 资源生成：同时调用星火 chat 的最大并发（默认 1=串行，避免 11202 AppIdQpsOverFlow；配额高可改为 2）
RESOURCE_LLM_CONCURRENCY=1

# 星火 QPS 超限（11202）时 chat_completion 额外退避重试次数上限（含首次，默认 6）
SPARK_QPS_MAX_ATTEMPTS=6
SPARK_QPS_RETRY_BASE_SEC=1.0

# 联网检索（学习检索 Tab）：ddgs 引擎顺序，逗号分隔；失败会自动用 Wikipedia
WEB_SEARCH_BACKENDS=mojeek,brave,duckduckgo,yahoo
WEB_SEARCH_TIMEOUT=25

# 应用配置
APP_SECRET_KEY=your_random_secret_key_here
